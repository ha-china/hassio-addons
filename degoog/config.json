{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "boot": "auto",
  "description": "[老王杂谈说]：一个搜索聚合器会查询多个引擎并将结果展示在一个地方。您可以添加自定义搜索引擎、bang-command 插件、插槽插件（位于结果上方/下方的查询触发面板或在侧边栏），以及传输器（自定义 HTTP 获取策略，如 curl、FlareSolverr 或您自己的）。最理想的愿景是最终建立一个由用户制作的插件/引擎市场。",
  "environment": {
    "DEGOOG_DATA_DIR": "/config/",
    "PUID": "0",
    "PGID": "0"
  },
  "map": [
    "addon_config:rw"
  ],
  "version": "1.1.1",
  "name": "degoog",
  "options": {},
  "ports": {
    "4445/tcp": "4445"
  },
  "ports_description": {
    "4445/tcp": "Web interface (direct, without ingress)"
  },
  "schema": {},
  "slug": "degoog",
  "startup": "services",
  "upstream": "latest",
  "url": "https://gh-proxy.org/github.com/jdeath/homeassistant-addons",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:4445]",
  "panel_admin": false,
  "ingress": true,
  "ingress_port": 4444
}
