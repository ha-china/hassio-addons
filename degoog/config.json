{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "boot": "auto",
  "description": "[老王杂谈说]：这是一个搜索聚合器，可查询多个引擎并将结果显示在同一位置。您可以添加自定义搜索引擎、bang-command 插件、插槽插件（搜索结果上方的结果面板、结果下方或侧边栏的查询触发面板）以及传输方式（如 curl、FlareSolverr 或自定义的 HTTP 获取策略）。理想情况下，未来会建立一个由用户制作的插件/搜索引擎市场。",
  "environment": {
    "DEGOOG_DATA_DIR": "/config/",
    "PUID": "0",
    "PGID": "0"
  },
  "map": [
    "addon_config:rw"
  ],
  "version": "1.0.0",
  "name": "degoog",
  "options": {},
  "ports": {
    "4445/tcp": "4445"
  },
  "ports_description": {
    "4445/tcp": "Web interface (direct, without ingress)"
  },
  "schema": {},
  "slug": "degoog",
  "startup": "services",
  "upstream": "latest",
  "url": "https://gh-proxy.org/github.com/jdeath/homeassistant-addons",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:4445]",
  "panel_admin": false,
  "ingress": true,
  "ingress_port": 4444
}
