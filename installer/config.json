  "map": ["homeassistant_config:rw", "share:rw"],
  "hassio_api": true,
  "homeassistant_api": true,
  "hassio_role": "manager",
  "image": "crpi-tuq1xajq0lk6s0kt.cn-shanghai.personal.cr.aliyuncs.com/hachina/installer-{arch}",
  "full_access": false,
  "apparmor": true,
  "options": {
    "env_vars": []
