{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "boot": "manual",
  "description": "[老王杂谈说]：运行在用户自己机器上的 Open Game Master 允许使用 AI 跑团师进行多人或单人版的《5e》角色扮演游戏。",
  "environment": {
    "AD_SERVER__PORT": "4141"
  },
  "map": [
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/app/data"
    }
  ],
  "version": "0.34.3",
  "name": "Open Game Master",
  "ports": {
    "3005/tcp": "3005"
  },
  "ports_description": {
    "3005/tcp": "WebUI"
  },
  "slug": "opendm",
  "startup": "services",
  "upstream": "0.1.0",
  "webui": "[PROTO:ssl]://[HOST]:[PORT:3005]",
  "ingress": false,
  "ingress_port": 3005,
  "url": "https://gh-proxy.org/github.com/jdeath/homeassistant-addons"
}
