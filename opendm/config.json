{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "boot": "manual",
  "description": "[老王杂谈说]：AI 游戏大师让您在自己的机器上运行多人游戏 (和单人游戏) 5e 战役。",
  "environment": {
    "AD_SERVER__PORT": "4141"
  },
  "map": [
    {
